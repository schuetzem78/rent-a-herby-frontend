{
  "name": "rent-a-herby-frontend",
  "version": "0.4.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve -o",
    "build": "ng build --output-hashing=all",
    "prod-build": "ng build --configuration production --output-hashing=all",
    "pages-build": "ng build --configuration production --base-href /",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "tailwind": "npx tailwindcss -i ./src/styles.css -o ./src/tailwind-generated.css --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^18.2.7",
    "@angular/cdk": "^18.2.7",
    "@angular/common": "^18.2.7",
    "@angular/compiler": "^18.2.7",
    "@angular/core": "^18.2.7",
    "@angular/forms": "^18.2.7",
    "@angular/material": "^18.2.7",
    "@angular/platform-browser": "^18.2.7",
    "@angular/platform-browser-dynamic": "^18.2.7",
    "@angular/router": "^18.2.7",
    "primeng": "^17.18.15",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.10"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^18.2.7",
    "@angular/cli": "^18.2.21",
    "@angular/compiler-cli": "^18.2.7",
    "@types/jasmine": "~5.1.15",
    "browser-sync": "^3.0.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.5.4"
  }
}
